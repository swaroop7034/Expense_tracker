// Example: A=+300, B=+100, C=-250, D=-150
// Correct:  C→A ₹250, D→A ₹50, D→B ₹100  (3 transactions)
// Wrong static-sort: may produce 4 transactions
it('returns empty array when all balances are zero')
it('resolves two-person debt in one transaction')
